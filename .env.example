# Copy this file to .env on the server.
# Never commit the real .env file.

# Backend mode for the no-local-GPU deployment path.
DEMO_RUNTIME=remote

# Google Gemini VLM: finds target coordinates from image + prompt.
GEMINI_API_KEY=replace-with-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Replicate depth endpoint: creates a metric depth map without a local GPU.
REPLICATE_API_TOKEN=replace-with-replicate-api-token
REPLICATE_DEPTH_MODEL=david20321/depth-anything-v3-metric-large
REPLICATE_DEPTH_VERSION=e3523ab17a5e6f0e279933a6afdde67efe130bb9e7753cafc52a4b082257f46b

# Web server settings.
HOST=0.0.0.0
PORT=8080
APP_PORT=8080
